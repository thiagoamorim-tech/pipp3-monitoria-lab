{
  "name": "pipp3-monitoria-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Gamificada com IA Preditiva para Gestao de Monitores (PIPP III - UEPB).",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create pipp3-monitoria-db",
    "d1:setup:local": "wrangler d1 execute pipp3-monitoria-db --local --file=./scripts/db_setup.sql",
    "d1:setup:remote": "wrangler d1 execute pipp3-monitoria-db --remote --file=./scripts/db_setup.sql"
  },
  "dependencies": {
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
